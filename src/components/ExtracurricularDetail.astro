---
import DateShower from "@/components/DateShower.astro";
import type { Extracurricular } from "../data/extracurricular";

const { extracurricularData } = Astro.props;

const {
  title,
  organization,
  location,
  startDate,
  endDate,
  description,
  responsibilities,
  currentRole,
} = extracurricularData as Extracurricular;
---

<div class="flex flex-col gap-2">
  <DateShower
    startDate={startDate}
    endDate={endDate}
    currentRole={currentRole}
  />

  <h3 class="text-xl font-bold">{title}</h3>

  <div class="flex gap-2 text-sm text-muted-foreground">
    <p>{organization}</p>
    <span>/</span>
    <p>{location}</p>
  </div>

  <p>{description}</p>

  {
    responsibilities.length > 0 && (
      <ul class="list-disc list-inside pl-2 mt-2">
        {responsibilities.map((item) => (
          <li>{item}</li>
        ))}
      </ul>
    )
  }
</div>
