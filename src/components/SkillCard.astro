---
// component imports
import { Icon } from "astro-icon/components";
import BaseFlipCard from "./BaseFlipCard.astro";

interface SkillCardProps {
  icon: string;
  name: string;
  showName?: boolean;
  containerClass?: string;
  // Añadimos deactivateAnimation a la interfaz si no estaba
  deactivateAnimation?: boolean;
}

const {
  icon,
  name,
  showName = false,
  containerClass,
  deactivateAnimation = true, // Por defecto true para skills
} = Astro.props as SkillCardProps;
---

<BaseFlipCard
  containerClass={containerClass}
  deactivateAnimation={deactivateAnimation}
  frontClass="bg-transparent border-none shadow-none"
  backClass="bg-n900 dark:bg-n800 text-white border border-n200 dark:border-n700"
>
  <div
    slot="front"
    class="w-full h-full flex flex-col justify-center items-center"
  >
    <div
      class="flex-shrink-0 flex items-center justify-center text-n700 dark:text-white"
    >
      {/* Ajustamos el tamaño del icono si es necesario */}
      <Icon name={icon} class="w-8 h-8" />
    </div>

    {
      showName && (
        <div class="text-n700 dark:text-n200 text-sm font-medium text-center mt-2">
          {name}
        </div>
      )
    }
  </div>
</BaseFlipCard>
