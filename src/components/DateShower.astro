---
import { Badge } from "./ui/badge";
import { formatDatetime } from "../lib/utils";

interface Props {
  startDate: string;
  endDate?: string;
  currentRole?: boolean;
}

const { startDate, endDate, currentRole } = Astro.props;
---

<Badge className="bg-primary-light dark:bg-primary-dark w-fit rounded-md">
  {formatDatetime(startDate)}
  {
    endDate || currentRole
      ? ` - ${currentRole ? "Present" : formatDatetime(endDate || "")}`
      : ""
  }
</Badge>
