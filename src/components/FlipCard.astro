---
import { Badge } from "./ui/badge";
import { formatDatetime } from "../lib/utils";
import BaseFlipCard from "./BaseFlipCard.astro";
import type { CardInfo } from "../interfaces/card";

interface Props {
  details: CardInfo;
  containerClass?: string;
  deactivateAnimation?: boolean;
}

const { details, containerClass, deactivateAnimation = false } = Astro.props;
---

<BaseFlipCard
  containerClass={`mt-10 ${containerClass}`}
  frontClass="bg-white dark:bg-n900 border border-n200 dark:border-n700"
  backClass="bg-n900 dark:bg-n800 text-white border border-n700"
  deactivateAnimation={deactivateAnimation}
>
  <div
    slot="front"
    class="h-full p-6 flex flex-col justify-between relative text-left"
  >
    {/* Contenido Superior */}
    <div class="relative z-10 flex flex-col gap-3">
      <Badge
        className="w-fit bg-primary/10 text-primary dark:bg-primary-dark/20 dark:text-primary-light border-0"
      >
        {
          details.current
            ? "Present"
            : `${formatDatetime(details.startDate)} ${details.endDate ? "- " + formatDatetime(details.endDate) : ""}`
        }
      </Badge>

      <div>
        <h3 class="text-2xl font-extrabold text-n100 text-white leading-tight">
          {details.title}
        </h3>
        <p
          class="text-lg font-medium text-primary dark:text-primary-light mt-1"
        >
          {details.subtitle}
        </p>
      </div>

      {
        details.location && (
          <div class="flex items-center gap-1 text-sm text-n500 dark:text-n400">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="14"
              height="14"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z" />
              <circle cx="12" cy="10" r="3" />
            </svg>
            {details.location}
          </div>
        )
      }
    </div>

    {/* Pie de la tarjeta */}
    <div
      class="relative z-10 w-full flex justify-between items-end border-t border-n200 dark:border-n700 pt-4 mt-4"
    >
      <div class="flex gap-1 overflow-hidden">
        {
          details.tags &&
            details.tags
              .slice(0, 2)
              .map((tag) => (
                <span class="text-xs text-muted-foreground bg-secondary/50 px-2 py-0.5 rounded">
                  {tag}
                </span>
              ))
        }
      </div>

      {
        /* Solo mostramos el indicador de interacción si la animación está activa */
      }
      {
        !deactivateAnimation && (
          <span class="text-xs text-white font-semibold uppercase tracking-widest text-n400 flex items-center gap-2">
            Info
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="animate-pulse"
            >
              <path d="M21 12a9 9 0 1 1-6.219-8.56" />
            </svg>
          </span>
        )
      }
    </div>
  </div>

  <div slot="back" class="h-full p-6 flex flex-col text-left">
    <div
      class="mb-4 pb-2 border-b border-white/10 flex justify-between items-center"
    >
      <h4 class="font-bold text-lg text-primary-light">Details</h4>
    </div>

    <div class="flex-1 overflow-y-auto pr-2 custom-scrollbar space-y-4">
      <p class="text-sm text-white/80 leading-relaxed">
        {details.description}
      </p>

      {
        details.listItems && details.listItems.length > 0 && (
          <div class="space-y-2">
            <h5 class="text-xs font-bold uppercase text-white/60 tracking-wider">
              Key Takeaways
            </h5>
            <ul class="space-y-2">
              {details.listItems.map((item) => (
                <li class="text-sm text-white/90 flex gap-2 items-start">
                  <span class="mt-1.5 w-1.5 h-1.5 rounded-full bg-white flex-shrink-0" />
                  <span class="leading-snug">{item}</span>
                </li>
              ))}
            </ul>
          </div>
        )
      }
    </div>
  </div>
</BaseFlipCard>

<style>
  .custom-scrollbar::-webkit-scrollbar {
    width: 3px;
  }
  .custom-scrollbar::-webkit-scrollbar-track {
    background: rgba(255, 255, 255, 0.05);
  }
  .custom-scrollbar::-webkit-scrollbar-thumb {
    background: rgba(255, 255, 255, 0.3);
    border-radius: 10px;
  }
</style>
